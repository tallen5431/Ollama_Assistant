# Ollama Configuration
# URL of your Ollama server (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Default model to use for requests (default: qwen2.5-coder:7b)
OLLAMA_MODEL=qwen2.5-coder:7b

# Heavy model for complex tasks (default: same as OLLAMA_MODEL)
# OLLAMA_MODEL_HEAVY=qwen2.5-coder:32b

# Request timeout in seconds (default: 120)
OLLAMA_TIMEOUT=120

# Startup Verification
# Require Ollama to be running at startup (default: true)
# Set to false to start the server even if Ollama is not available
REQUIRE_OLLAMA_ON_STARTUP=true

# Verify that required models exist in Ollama at startup (default: true)
# Set to false to skip model verification (server will start but API calls may fail)
VERIFY_MODELS_ON_STARTUP=true

# Number of connection retries at startup (default: 5)
OLLAMA_STARTUP_RETRIES=5

# Initial delay between retries in seconds (default: 2.0)
# Uses exponential backoff: 2s, 4s, 8s, 16s, 32s
OLLAMA_STARTUP_RETRY_DELAY=2.0

# Flask Server Configuration
# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Port to listen on (default: 8070)
PORT=8070

# Upload Configuration
# Directory to store uploaded snapshots (default: ./uploads)
# SNAPSHOT_UPLOAD_DIR=/path/to/uploads

# Maximum upload file size in MB (default: 50)
MAX_UPLOAD_SIZE_MB=50

# Maximum number of snapshots to keep (default: 100, 0=unlimited)
MAX_SNAPSHOTS=100
