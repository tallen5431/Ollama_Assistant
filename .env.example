# Ollama Configuration
# URL of your Ollama server (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Default model to use for requests (default: qwen2.5-coder:7b)
OLLAMA_MODEL=qwen2.5-coder:7b

# Heavy model for complex tasks (default: same as OLLAMA_MODEL)
# OLLAMA_MODEL_HEAVY=qwen2.5-coder:32b

# Request timeout in seconds (default: 120)
OLLAMA_TIMEOUT=120

# Flask Server Configuration
# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Port to listen on (default: 8070)
PORT=8070

# Upload Configuration
# Directory to store uploaded snapshots (default: ./uploads)
# SNAPSHOT_UPLOAD_DIR=/path/to/uploads

# Maximum upload file size in MB (default: 50)
MAX_UPLOAD_SIZE_MB=50

# Maximum number of snapshots to keep (default: 100, 0=unlimited)
MAX_SNAPSHOTS=100
