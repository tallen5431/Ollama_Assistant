# Overrides only — `use_default_settings` keeps everything else at SearXNG's
# own defaults, so this file stays short enough to check by eye.
use_default_settings: true

server:
  # Replace before the first start. SearXNG refuses to run on the default:
  #   sed -i "s|ultrasecretkey|$(openssl rand -hex 32)|" settings.yml
  secret_key: "ultrasecretkey"

  # Off, and this is the setting that matters most here.
  #
  # The limiter exists to stop a *public* instance being scraped, and it works
  # by deciding whether a request looks like a browser. This app is not a
  # browser, so with the limiter on every search comes back HTTP 429 and the
  # app reports it as such. A private instance on loopback has nobody to keep
  # out.
  limiter: false
  public_instance: false

search:
  # `json` is the whole point: SearXNG ships serving HTML only, and without
  # this line every search from the app fails with HTTP 403 and the message
  # "Invalid settings, please edit your preferences". It is the single most
  # common reason a fresh instance does not work.
  formats:
    - html
    - json

  # A pharmacy lookup, a part number, a medical abbreviation: this is a tool
  # for looking things up, and the filter mostly gets in the way of that.
  safe_search: 0

# Making sure these four are on. Not a restriction to these four, which is what
# this block used to claim: with `use_default_settings: true` an `engines:`
# block is *merged* into SearXNG's default list by name, so naming an engine
# here changes that engine's settings and leaves every other default enabled.
#
# Which is the right outcome anyway, and worth understanding rather than
# working around. The reason to run SearXNG at all is usually that one engine
# has flagged your address — and SearXNG runs on that same address, so it will
# be flagged there too. What saves the search is the *other* engines answering.
# A wider set is the point; a failing engine costs a timeout, not the query.
#
# To genuinely narrow it later, SearXNG's own mechanism is:
#
#   use_default_settings:
#     engines:
#       keep_only:
#         - duckduckgo
#         - brave
#
# — replacing the plain `use_default_settings: true` above. Change one thing at
# a time and check with tools/check_web.py, because a settings file SearXNG
# will not parse means it does not start at all.
#
# `!brave query` in the SearXNG page at http://127.0.0.1:8888 asks a single
# engine, which is the quick way to find out which ones your address is
# welcome on. The app now names the engines that refused it whenever a search
# comes back empty, which is the same question answered from the other side.
engines:
  - name: duckduckgo
    disabled: false
  - name: brave
    disabled: false
  - name: startpage
    disabled: false
  - name: wikipedia
    disabled: false
